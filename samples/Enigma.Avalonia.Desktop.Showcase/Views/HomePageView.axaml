<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:vm="using:Enigma.Avalonia.Desktop.Showcase.ViewModels"
             x:Class="Enigma.Avalonia.Desktop.Showcase.Views.HomePageView"
             x:DataType="vm:HomePageViewModel">

  <ScrollViewer>
    <StackPanel Margin="32" Spacing="24" MaxWidth="840" HorizontalAlignment="Left">

      <StackPanel Orientation="Horizontal" Spacing="16">
        <!-- ei:Icon rather than {ei:IconGeometry}: the markup extension is evaluated once at load
             time, while the control re-resolves at render time and follows a theme switch. -->
        <ei:Icon Kind="Cube"
                 Weight="Duotone"
                 Size="44"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource EnigmaAccentBrush}" />
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding Heading}"
                     FontSize="28"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource EnigmaForegroundBrush}" />
          <TextBlock Text="{Binding Tagline}"
                     FontSize="14"
                     Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
        </StackPanel>
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Highlights}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HomeHighlight">
            <Border Background="{DynamicResource EnigmaSurfaceBrush}"
                    BorderBrush="{DynamicResource EnigmaBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
              <!-- A Grid, not a horizontal StackPanel: a StackPanel offers its children unlimited
                   width along its orientation, so TextWrapping on the description would never fire. -->
              <Grid ColumnDefinitions="Auto,*">
                <ei:Icon Grid.Column="0"
                         Kind="{Binding Icon}"
                         Size="22"
                         Margin="0,2,14,0"
                         VerticalAlignment="Top"
                         Foreground="{DynamicResource EnigmaAccentBrush}" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding Title}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource EnigmaForegroundBrush}" />
                  <TextBlock Text="{Binding Description}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding Footnote}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
