<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:vm="using:Enigma.Avalonia.Desktop.Showcase.ViewModels"
             xmlns:data="using:Enigma.Avalonia.Desktop.Data"
             xmlns:editors="using:Enigma.Avalonia.Desktop.Controls.Editors"
             x:Class="Enigma.Avalonia.Desktop.Showcase.Views.CollectionViewPageView"
             x:DataType="vm:CollectionViewPageViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundBrush}" />
    </Style>
    <!-- The group heading above each set of rows in the grouped list. -->
    <Style Selector="TextBlock.groupHeader">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="840" HorizontalAlignment="Left">

      <TextBlock Text="CollectionView"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource EnigmaForegroundBrush}" />
      <TextBlock Classes="hint"
                 Text="One ObservableCollection, one view over it. Sorting, filtering and grouping all happen in the view — the source keeps its insertion order throughout, and the lists below never see it." />

      <!-- Controls -->
      <Border Background="{DynamicResource EnigmaSurfaceBrush}"
              BorderBrush="{DynamicResource EnigmaBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16">
        <StackPanel Spacing="12">

          <editors:TextEditor PlaceholderText="Filter by name or department..."
                              Text="{Binding FilterText, Mode=TwoWay}">
            <editors:TextEditor.LeadingContent>
              <ei:Icon Kind="MagnifyingGlass"
                       Size="16"
                       Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
            </editors:TextEditor.LeadingContent>
          </editors:TextEditor>

          <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Sort by"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
              <ComboBox ItemsSource="{Binding SortProperties}"
                        SelectedItem="{Binding SortProperty, Mode=TwoWay}"
                        MinWidth="140" />
            </StackPanel>

            <ToggleSwitch IsChecked="{Binding SortDescending, Mode=TwoWay}"
                          OnContent="Descending"
                          OffContent="Ascending"
                          VerticalAlignment="Center" />

            <CheckBox IsChecked="{Binding IsGrouped, Mode=TwoWay}"
                      Content="Group by department"
                      VerticalAlignment="Center" />
          </WrapPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Add person" Command="{Binding AddPersonCommand}" />
            <Button Content="Remove last" Command="{Binding RemoveLastCommand}" />
            <Button Content="Reset" Command="{Binding ResetCommand}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding PeopleView.View.Count}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource EnigmaForegroundBrush}" />
            <TextBlock Text="of"
                       Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
            <TextBlock Text="{Binding TotalCount}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource EnigmaForegroundBrush}" />
            <TextBlock Text="people shown"
                       Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- Flat list: the view itself is IEnumerable, so it binds straight to ItemsSource and raises a
           Reset every time it refreshes. -->
      <StackPanel Spacing="8" IsVisible="{Binding !IsGrouped}">
        <TextBlock Classes="section" Text="The view" />
        <ListBox ItemsSource="{Binding PeopleView.View}" MaxHeight="320">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PersonItem">
              <!-- Adjacent Runs stay on one line: a newline between two Runs is itself an inline, and
                   would render as an extra space. -->
              <TextBlock><Run Text="{Binding LastName}" FontWeight="SemiBold" /><Run Text=", " /><Run Text="{Binding FirstName}" /><Run Text="  —  " /><Run Text="{Binding Department}" Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" /></TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <!-- Grouped list: Groups is null until a GroupDescription is added, and a list of
           CollectionViewGroup afterwards. Each group keeps the sort applied to the view. -->
      <StackPanel Spacing="8" IsVisible="{Binding IsGrouped}">
        <TextBlock Classes="section" Text="The view, grouped" />
        <ItemsControl ItemsSource="{Binding PeopleView.View.Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="data:CollectionViewGroup">
              <Border Background="{DynamicResource EnigmaSurfaceBrush}"
                      BorderBrush="{DynamicResource EnigmaBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="12"
                      Margin="0,0,0,8">
                <StackPanel Spacing="6">
                  <TextBlock Classes="groupHeader"><Run Text="{Binding Key}" /><Run Text=" (" /><Run Text="{Binding ItemCount}" /><Run Text=")" /></TextBlock>
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PersonItem">
                        <TextBlock Margin="12,2,0,2" Foreground="{DynamicResource EnigmaForegroundBrush}"><Run Text="{Binding LastName}" FontWeight="SemiBold" /><Run Text=", " /><Run Text="{Binding FirstName}" /></TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- The source, in its own order, so it is visible that the view never touches it. -->
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="The source collection" />
        <TextBlock Classes="hint"
                   Text="Insertion order, unfiltered and ungrouped — this is what People actually holds." />
        <ItemsControl ItemsSource="{Binding People}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PersonItem">
              <TextBlock Margin="0,1" Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}"><Run Text="{Binding FirstName}" /><Run Text=" " /><Run Text="{Binding LastName}" /></TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>
