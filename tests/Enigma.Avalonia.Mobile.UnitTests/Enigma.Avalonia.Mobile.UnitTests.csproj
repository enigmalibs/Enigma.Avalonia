<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (LangVersion, Nullable, ImplicitUsings, TreatWarningsAsErrors,
       EnforceCodeStyleInBuild, Authors, Copyright) are inherited from Directory.Build.props and must
       never be repeated here — plan FEATURE-28E8 §2.4.4. -->
  <PropertyGroup>
    <!-- Mirrors the library under test, which targets net10.0 alone (plan FEATURE-7555 §3). -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects are standalone executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- Deliberately NOT set: GenerateDocumentationFile. Under TreatWarningsAsErrors it would make
         CS1591 fire on every public test class. -->
  </PropertyGroup>

  <!-- The same MTP-native pair as the Desktop test project: no Microsoft.NET.Test.Sdk and no
       xunit.runner.visualstudio, whose VSTest-era runner breaks the Microsoft Testing Platform.
       No Version= — Central Package Management (plan FEATURE-28E8 §2.3, §2.4.8). -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Enigma.Avalonia.Mobile\Enigma.Avalonia.Mobile.csproj" />
  </ItemGroup>

  <!-- The canonical palette — Desktop's two dictionaries, which the mobile assembly compiles as linked
       resources — embedded verbatim, so every expectation is read from the source rather than
       hand-copied into a test. The compiled assembly cannot serve as the source: the XAML compiler
       replaces each .axaml with IL. LogicalName drops the directory, which keeps the manifest names
       free of host path separators. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\Enigma.Avalonia.Desktop\Themes\Colors.axaml;..\..\src\Enigma.Avalonia.Desktop\Themes\Brushes.axaml">
      <LogicalName>PaletteSource/%(Filename)%(Extension)</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

</Project>
