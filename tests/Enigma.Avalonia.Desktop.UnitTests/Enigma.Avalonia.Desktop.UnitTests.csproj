<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (LangVersion, Nullable, ImplicitUsings, TreatWarningsAsErrors,
       EnforceCodeStyleInBuild, Authors, Copyright) are inherited from Directory.Build.props and must
       never be repeated here — plan FEATURE-28E8 §2.4.4. -->
  <PropertyGroup>
    <!-- Plan §2.2: net10.0 alone, a deliberate deviation from the xunit-v3 "mirror the library's
         TFMs" convention. Headless Avalonia tests are the slow kind, and the library still compiles
         for net8.0 on every build, so a net8-only compile break is still caught. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects are standalone executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- Deliberately NOT set: GenerateDocumentationFile. Under TreatWarningsAsErrors it would make
         CS1591 fire on every public test class. -->
  </PropertyGroup>

  <!-- No Microsoft.NET.Test.Sdk and no xunit.runner.visualstudio: that VSTest-era pair breaks the
       Microsoft Testing Platform, whose runner comes from global.json. Avalonia.Headless.XUnit is
       xUnit v3-native, so there is no v2/v3 conflict with xunit.v3.
       No Version= — Central Package Management (plan §2.3, §2.4.8). -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Enigma.Avalonia.Desktop\Enigma.Avalonia.Desktop.csproj" />
  </ItemGroup>

  <!-- The library's theme XAML, embedded verbatim so the resource-key tests can read what the
       templates actually reference. It cannot come from the library assembly: the Avalonia XAML
       compiler replaces every AvaloniaResource .axaml with compiled IL, so AssetLoader.Open on one
       throws FileNotFoundException. Embedding the source here keeps the tests free of any
       filesystem lookup at run time while still reading the real, current files.
       LogicalName is set explicitly — the default manifest name for an item outside the project
       directory is not stable across SDKs or path separators. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\Enigma.Avalonia.Desktop\Themes\**\*.axaml">
      <LogicalName>ThemeSource/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

</Project>
