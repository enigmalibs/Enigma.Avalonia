<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Enigma.Avalonia.Desktop.Controls.ContentDialog">

  <ControlTheme x:Key="{x:Type controls:ContentDialog}" TargetType="controls:ContentDialog">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="IconBrush" Value="{DynamicResource EnigmaForegroundBrush}" />
    <!-- The card's fill. A setter rather than a literal in the template, so Background on the dialog
         paints the card, and a redefined EnigmaSurfaceHighBrush in the dialog's own Resources still
         applies. -->
    <Setter Property="Background" Value="{DynamicResource EnigmaSurfaceHighBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- Overlay -->
          <Border Name="PART_Overlay"
                  Background="{TemplateBinding OverlayBrush}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" />

          <!-- Dialog Content -->
          <Border Name="PART_Card"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource EnigmaBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Width="{TemplateBinding DialogWidth}"
                  Height="{TemplateBinding DialogHeight}"
                  MinWidth="{TemplateBinding DialogMinWidth}"
                  MaxWidth="{TemplateBinding DialogMaxWidth}"
                  MinHeight="{TemplateBinding DialogMinHeight}"
                  MaxHeight="{TemplateBinding DialogMaxHeight}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  BoxShadow="0 12 48 0 #99000000">
            <Grid RowDefinitions="Auto,*,Auto" Margin="24">
              <!-- Title -->
              <TextBlock Grid.Row="0"
                         Text="{TemplateBinding Title}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Margin="0,0,0,16"
                         IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <!-- Icon and Content -->
              <ScrollViewer Grid.Row="1"
                            Margin="0,0,0,24"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,*">
                  <!-- Icon -->
                  <Viewbox Grid.Column="0"
                           Width="48"
                           Height="48"
                           VerticalAlignment="Top"
                           Margin="0,0,16,0"
                           IsVisible="{TemplateBinding IconData, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Path Data="{TemplateBinding IconData}"
                          Fill="{TemplateBinding IconBrush}"
                          Stretch="Uniform" />
                  </Viewbox>

                  <!-- Content -->
                  <ContentPresenter Grid.Column="1"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Grid>
              </ScrollViewer>

              <!-- Buttons -->
              <StackPanel Grid.Row="2"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Spacing="8">
                <Button Name="PART_PrimaryButton"
                        Content="{TemplateBinding PrimaryButtonText}"
                        IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}"
                        MinWidth="80"
                        HorizontalContentAlignment="Center"
                        Classes="accent"
                        IsVisible="{TemplateBinding PrimaryButtonText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Name="PART_SecondaryButton"
                        Content="{TemplateBinding SecondaryButtonText}"
                        IsEnabled="{TemplateBinding IsSecondaryButtonEnabled}"
                        MinWidth="80"
                        HorizontalContentAlignment="Center"
                        IsVisible="{TemplateBinding SecondaryButtonText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Name="PART_CloseButton"
                        Content="{TemplateBinding CloseButtonText}"
                        IsEnabled="{TemplateBinding IsCloseButtonEnabled}"
                        MinWidth="80"
                        HorizontalContentAlignment="Center"
                        IsVisible="{TemplateBinding CloseButtonText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Show dialog when IsOpen is true -->
    <Style Selector="^[IsOpen=True]">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Secondary: the card on the window-background tone rather than the raised dialog surface, for
         content laid out for the window's own background. Classes="secondary" on the host. -->
    <Style Selector="^.secondary">
      <Setter Property="Background" Value="{DynamicResource EnigmaDialogSecondaryBackgroundBrush}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
